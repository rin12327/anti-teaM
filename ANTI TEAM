createPlayerDropdown("Chọn người chơi Fling (Chọn nhiều):", true, function(name)
    local idx = table.find(selectedFlingPlayers, name)
    if idx then table.remove(selectedFlingPlayers, idx) else table.insert(selectedFlingPlayers, name) end
end)

local startPosFling = nil
local currentFlingIndex = 1
local flingMode = nil
local flingTargetName = nil
local flingStartT = 0
local flingCycle = 0
local flingTracker = newTracker()

local FlingOnceBtn = makeButton("Bật/Tắt Fling 1 Lần", ORANGE, 32)
local FlingLoopBtn = makeButton("Bật/Tắt Fling Liên Tục", ORANGE, 32)

local function setFlingButtons()
    FlingOnceBtn.BackgroundColor3 = (flingMode == "ONCE") and GREEN or ORANGE
    FlingLoopBtn.BackgroundColor3 = (flingMode == "LOOP") and GREEN or ORANGE
end

local function stopFling()
    flingMode = nil
    flingTargetName = nil
    setFlingButtons()
    local _, hrp, hum = getChar()
    if hum then hum.PlatformStand = false end
    if hrp then
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        if startPosFling then hrp.CFrame = startPosFling end
    end
    startPosFling = nil
end

local function toggleFling(mode)
    if flingMode == mode then
        stopFling()
    else
        flingMode = mode
        currentFlingIndex = 1
        flingTargetName = nil
        local _, hrp = getChar()
        if hrp and not startPosFling then startPosFling = hrp.CFrame end
        setFlingButtons()
    end
end

FlingOnceBtn.MouseButton1Click:Connect(function() toggleFling("ONCE") end)
FlingLoopBtn.MouseButton1Click:Connect(function() toggleFling("LOOP") end)

local function nextFlingTarget()
    currentFlingIndex = currentFlingIndex + 1
    flingTargetName = nil
end

track(RunService.Heartbeat:Connect(function()
    if not flingMode or #selectedFlingPlayers == 0 then return end
    local _, hrp, hum = getChar()
    if not hrp or not hum then return end

    if currentFlingIndex > #selectedFlingPlayers then
        if flingMode == "ONCE" then
            stopFling()
            return
        else
            currentFlingIndex = 1
        end
    end

    local name = selectedFlingPlayers[currentFlingIndex]
    local p = Players:FindFirstChild(name)
    local tChar = p and p.Character
    local tHRP = tChar and tChar:FindFirstChild("HumanoidRootPart")
    local tHum = tChar and tChar:FindFirstChildOfClass("Humanoid")
    if not tHRP or not tHum or tHum.Health <= 0 then
        nextFlingTarget()
        return
    end

    if flingTargetName ~= name then
        flingTargetName = name
        flingStartT = tick()
        flingTracker.reset()
    end

    if not hum.PlatformStand then hum.PlatformStand = true end

    local vel = flingTracker.update(tHRP)
    local moveVel = tHum.MoveDirection * tHum.WalkSpeed
    if moveVel.Magnitude > vel.Magnitude then vel = moveVel end

    -- Nạn nhân đã bị hất bay quá nhanh hoặc quá 3 giây -> sang người tiếp theo
    if vel.Magnitude > 300 or (tick() - flingStartT) > 3 then
        nextFlingTarget()
        return
    end

    local speed = vel.Magnitude
    local dir = speed > 1 and vel.Unit or tHRP.CFrame.LookVector
    local lead = getLead()
    local predicted = tHRP.Position + vel * lead

    -- Xoay vòng nhiều vị trí quanh hitbox (đầu hướng chạy, sau lưng, trên, dưới...) để chắc chắn va chạm
    flingCycle = flingCycle + 1
    local offsets = {
        Vector3.new(0, 0, 0),
        dir * 3,
        dir * -3,
        Vector3.new(0, 2, 0),
        Vector3.new(0, -1.5, 0),
        dir * 6 + Vector3.new(0, 1, 0),
    }
    local o = offsets[(flingCycle % #offsets) + 1]
    hrp.CFrame = CFrame.new(predicted + o)

    local s = (flingCycle % 2 == 0) and 1 or -1
    hrp.AssemblyLinearVelocity = Vector3.new(12000 * s, 4000, 12000 * s)
    hrp.AssemblyAngularVelocity = Vector3.new(15000, 15000, 15000)
end))

