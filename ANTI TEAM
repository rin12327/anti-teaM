-- Extreme Anti-Lag ------------------------------------------------
local EFFECT_CLASSES = {
    "ParticleEmitter", "Trail", "Beam", "Fire", "Smoke", "Sparkles", "Highlight", "Explosion",
    "PointLight", "SpotLight", "SurfaceLight", "Sound", "Shirt", "Pants", "ShirtGraphic",
    "SurfaceAppearance", "ForceField", "Texture",
}

local function isEffect(obj)
    for _, cn in ipairs(EFFECT_CLASSES) do
        if obj:IsA(cn) then return true end
    end
    return false
end

local function isCharacterModel(m)
    if not m:IsA("Model") then return false end
    if Players:GetPlayerFromCharacter(m) then return true end
    return Players:FindFirstChild(m.Name) ~= nil and m:FindFirstChildOfClass("Humanoid") ~= nil
end

local function inPlayerCharacter(obj)
    local m = obj
    while m and m ~= workspace and m ~= game do
        if isCharacterModel(m) then return true end
        m = m.Parent
    end
    return false
end

local function containsPlayerCharacter(obj)
    for _, pl in ipairs(Players:GetPlayers()) do
        local ch = pl.Character
        if ch and (ch == obj or ch:IsDescendantOf(obj)) then return true end
        local f = obj:FindFirstChild(pl.Name, true)
        if f and f:IsA("Model") and f:FindFirstChildOfClass("Humanoid") then return true end
    end
    return false
end

local function cleanCharacterObject(obj)
    if isEffect(obj) then
        pcall(function() obj:Destroy() end)
    elseif obj:IsA("BasePart") then
        obj.Material = Enum.Material.SmoothPlastic
        obj.CastShadow = false
        obj.Reflectance = 0
    end
end

local function cleanCharacter(ch)
    for _, d in ipairs(ch:GetDescendants()) do
        cleanCharacterObject(d)
    end
end

local function shouldKeep(obj)
    return obj == platform or obj:IsA("Camera") or obj:IsA("Terrain") or obj:IsA("SpawnLocation")
end

local function purge(container)
    for _, child in ipairs(container:GetChildren()) do
        if shouldKeep(child) then
            -- giữ lại
        elseif isCharacterModel(child) then
            -- giữ nhân vật
        elseif (child:IsA("Model") or child:IsA("Folder")) and containsPlayerCharacter(child) then
            purge(child)
        else
            pcall(function() child:Destroy() end)
        end
    end
end

local function cleanLighting()
    for _, o in ipairs(Lighting:GetChildren()) do
        if o:IsA("Sky") or o:IsA("Atmosphere") or o:IsA("PostEffect") or o:IsA("Clouds") then
            pcall(function() o:Destroy() end)
        end
    end
    Lighting.GlobalShadows = false
    Lighting.FogStart = 0
    Lighting.FogEnd = 9e9
    Lighting.Brightness = 2
    Lighting.ClockTime = 14
    Lighting.Ambient = Color3.fromRGB(150, 150, 150)
    Lighting.OutdoorAmbient = Color3.fromRGB(150, 150, 150)
    pcall(function() Lighting.ExposureCompensation = 0 end)
    pcall(function() Lighting.EnvironmentDiffuseScale = 0 end)
    pcall(function() Lighting.EnvironmentSpecularScale = 0 end)
    pcall(function() sethiddenproperty(Lighting, "Technology", Enum.Technology.Legacy) end)
end

local function destroySounds(root)
    if not root then return end
    for _, d in ipairs(root:GetDescendants()) do
        if d:IsA("Sound") then pcall(function() d:Destroy() end) end
    end
    track(root.DescendantAdded:Connect(function(d)
        if d:IsA("Sound") then
            task.defer(function() pcall(function() d:Destroy() end) end)
        end
    end))
end

local function purgeEverything()
    -- Gom SpawnLocation ra workspace để giữ lại
    for _, d in ipairs(workspace:GetDescendants()) do
        if d:IsA("SpawnLocation") and not inPlayerCharacter(d) then
            pcall(function() d.Parent = workspace end)
        end
    end

    pcall(function() workspace.Terrain:Clear() end)
    pcall(function()
        for _, c in ipairs(workspace.Terrain:GetChildren()) do c:Destroy() end
        workspace.Terrain.WaterWaveSize = 0
        workspace.Terrain.WaterReflectance = 0
        workspace.Terrain.WaterTransparency = 1
    end)
    pcall(function() sethiddenproperty(workspace.Terrain, "Decoration", false) end)

    purge(workspace)

    for _, d in ipairs(workspace:GetChildren()) do
        if d:IsA("SpawnLocation") then
            d.Transparency = 0
            d.CanCollide = true
            d.Material = Enum.Material.SmoothPlastic
            d.CastShadow = false
            for _, x in ipairs(d:GetChildren()) do
                if x:IsA("Decal") or x:IsA("Texture") then x:Destroy() end
            end
        end
    end

    for _, pl in ipairs(Players:GetPlayers()) do
        if pl.Character then cleanCharacter(pl.Character) end
    end

    cleanLighting()
    track(Lighting.ChildAdded:Connect(function(o)
        if o:IsA("Sky") or o:IsA("Atmosphere") or o:IsA("PostEffect") or o:IsA("Clouds") then
            task.defer(function() pcall(function() o:Destroy() end) end)
        end
    end))
    task.spawn(function()
        while running do
            cleanLighting()
            task.wait(2)
        end
    end)

    pcall(function() settings().Rendering.QualityLevel = Enum.QualityLevel.Level01 end)

    pcall(function() SoundService.AmbientReverb = Enum.ReverbType.NoReverb end)
    destroySounds(workspace)
    destroySounds(SoundService)
    destroySounds(Lighting)
    destroySounds(LocalPlayer:FindFirstChild("PlayerGui"))

    -- Chỉ tắt UI phụ của Roblox, KHÔNG đụng tới nút điều khiển/nút đánh của game
    for _, t in ipairs({Enum.CoreGuiType.PlayerList, Enum.CoreGuiType.Chat, Enum.CoreGuiType.EmotesMenu, Enum.CoreGuiType.Health}) do
        pcall(function() StarterGui:SetCoreGuiEnabled(t, false) end)
    end

    track(workspace.DescendantAdded:Connect(function(obj)
        local isContainer = obj:IsA("Model") or obj:IsA("Folder")
        task.delay(isContainer and 0.4 or 0.08, function()
            if not running or not obj:IsDescendantOf(workspace) then return end
            if obj == platform or obj:IsA("Camera") or obj:IsA("Terrain") or obj:IsA("SpawnLocation") then return end
            if inPlayerCharacter(obj) then
                cleanCharacterObject(obj)
                return
            end
            if isContainer and (isCharacterModel(obj) or containsPlayerCharacter(obj)) then return end
            pcall(function() obj:Destroy() end)
        end)
    end))
end

