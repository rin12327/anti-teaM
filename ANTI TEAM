-- CODE GỐC TUNG CHIÊU TỪ FILE CHO PC KÈM HỖ TRỢ ĐIỆN THOẠI
task.spawn(function()
    local skills = {Enum.KeyCode.One, Enum.KeyCode.Two, Enum.KeyCode.Three, Enum.KeyCode.Four}
    local skillIndex = 1
    while true do
        if attackActive and selectedAttackTarget then
            pcall(function()
                -- MẶC ĐỊNH LUÔN CHẠY GỐC CHO PC (ĐẢM BẢO KHÔNG LỖI)
                local key = skills[skillIndex]
                VirtualInputManager:SendKeyEvent(true, key, false, game)
                task.wait(0.05)
                VirtualInputManager:SendKeyEvent(false, key, false, game)
                
                -- KẾT HỢP SONG SONG: Nhấn vào vùng chiêu (PlayerGui.Hotbar.Backpack hoặc nút kỹ năng di động) cho điện thoại
                local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
                if playerGui then
                    local function clickTouchButton(btnObj)
                        if btnObj and btnObj.AbsolutePosition.X > 0 and btnObj.AbsoluteSize.X > 0 then
                            local targetX = btnObj.AbsolutePosition.X + (btnObj.AbsoluteSize.X / 2)
                            local targetY = btnObj.AbsolutePosition.Y + (btnObj.AbsoluteSize.Y / 2)
                            VirtualInputManager:SendMouseButtonEvent(targetX, targetY, 0, true, game, 1)
                            task.wait(0.02)
                            VirtualInputManager:SendMouseButtonEvent(targetX, targetY, 0, false, game, 1)
                        end
                    end

                    local hotbar = playerGui:FindFirstChild("Hotbar")
                    if hotbar then
                        local backpackUI = hotbar:FindFirstChild("Backpack") or hotbar:FindFirstChild("MobileButtons") or hotbar:FindFirstChild("Skills")
                        if backpackUI then
                            local children = backpackUI:GetChildren()
                            local validBtns = {}
                            for _, child in ipairs(children) do
                                if child:IsA("GuiButton") or child:IsA("Frame") or child:IsA("ImageButton") then
                                    table.insert(validBtns, child)
                                end
                            end
                            if #validBtns >= skillIndex then
                                clickTouchButton(validBtns[skillIndex])
                            elseif backpackUI.AbsolutePosition.X > 0 then
                                local sectionWidth = backpackUI.AbsoluteSize.X / 4
                                local targetX = backpackUI.AbsolutePosition.X + (sectionWidth * (skillIndex - 1)) + (sectionWidth / 2)
                                local targetY = backpackUI.AbsolutePosition.Y + (backpackUI.AbsoluteSize.Y / 2)
                                VirtualInputManager:SendMouseButtonEvent(targetX, targetY, 0, true, game, 1)
                                task.wait(0.02)
                                VirtualInputManager:SendMouseButtonEvent(targetX, targetY, 0, false, game, 1)
                            end
                        end
                    end
                end
            end)
            skillIndex = skillIndex % #skills + 1
            task.wait(1) 
        else
            task.wait(0.5)
        end
    end
end)

