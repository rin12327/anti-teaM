    setFlingButtons()
    local _, hrp, hum = getChar()
    if hum then hum.PlatformStand = false end
    if hrp then
        zeroSelf(hrp)
        if startPosFling then hrp.CFrame = startPosFling end
    end
    startPosFling = nil
    restoreCamera()
end

local function toggleFling(mode)
    if flingMode == mode then
        stopFling()
    else
        flingMode = mode
        currentFlingIndex = 1
        flingTargetName = nil
        flingSkips = 0
        local _, hrp = getChar()
        if hrp and not startPosFling then startPosFling = hrp.CFrame end
        setFlingButtons()
    end
end

FlingOnceBtn.MouseButton1Click:Connect(function() toggleFling("ONCE") end)
FlingLoopBtn.MouseButton1Click:Connect(function() toggleFling("LOOP") end)

local function nextFlingTarget(skipped)
    currentFlingIndex = currentFlingIndex + 1
    flingTargetName = nil
    if skipped then flingSkips = flingSkips + 1 end
end

track(RunService.Heartbeat:Connect(function()
    if not flingMode or #selectedFlingPlayers == 0 then return end
    local _, hrp, hum = getChar()
    if not hrp or not hum then return end

    if currentFlingIndex > #selectedFlingPlayers then
        if flingMode == "ONCE" then
            stopFling()
            return
        end
        currentFlingIndex = 1
    end

    local name = selectedFlingPlayers[currentFlingIndex]
    local p = Players:FindFirstChild(name)
    local tChar = p and p.Character
    local tHRP = tChar and tChar:FindFirstChild("HumanoidRootPart")
    local tHum = tChar and tChar:FindFirstChildOfClass("Humanoid")

    local function allFlung()
        zeroSelf(hrp)
        if flingSkips >= #selectedFlingPlayers then
            if hum.PlatformStand then hum.PlatformStand = false end
            if spectating then restoreCamera() end
        end
    end

    if not tHRP or not tHum or tHum.Health <= 0 then
        nextFlingTarget(true)
        allFlung()
        return
    end

    -- Nhìn tốc độ nạn nhân: cao = đã văng -> dừng fling người này
    local tracker = getTracker(name)
    local trackedVel = tracker.update(tHRP)
    local speed = math.max(trackedVel.Magnitude, tHRP.AssemblyLinearVelocity.Magnitude)
    if speed > FLING_STOP_SPEED then
        nextFlingTarget(true)
        allFlung()
        return
    end

    -- Nạn nhân còn chậm (đi bộ, chạy, té...) -> fling tiếp
    flingSkips = 0
    if flingTargetName ~= name then
        flingTargetName = name
        flingStartT = tick()
    end
    if tick() - flingStartT > FLING_MAX_TIME then
        nextFlingTarget(false)
        return
    end

    if not hum.PlatformStand then hum.PlatformStand = true end
    setSpectate(tHum)

    local vel = trackedVel
    local moveVel = tHum.MoveDirection * tHum.WalkSpeed
    if moveVel.Magnitude > vel.Magnitude then vel = moveVel end

    local dir = vel.Magnitude > 1 and vel.Unit or tHRP.CFrame.LookVector
    local predicted = tHRP.Position + vel * getLead()

    -- Xoay vòng nhiều vị trí quanh hitbox để chắc chắn va chạm
    flingCycle = flingCycle + 1
    local offsets = {
        Vector3.new(0, 0, 0),
        dir * 3,
        dir * -3,
        Vector3.new(0, 2, 0),
        Vector3.new(0, -1.5, 0),
        dir * 6 + Vector3.new(0, 1, 0),
    }
    local myPos = predicted + offsets[(flingCycle % #offsets) + 1]
    hrp.CFrame = faceCF(myPos, predicted, dir) -- luôn quay mặt vào nạn nhân

    local s = (flingCycle % 2 == 0) and 1 or -1
    hrp.AssemblyLinearVelocity = Vector3.new(12000 * s, 4000, 12000 * s)
    hrp.AssemblyAngularVelocity = Vector3.new(15000, 15000, 15000)
end))

