---------------------------------------------------------
local ExtremeBtn = Instance.new("TextButton")
ExtremeBtn.Size = UDim2.new(1, 0, 0, 35)
ExtremeBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 120)
ExtremeBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
ExtremeBtn.Text = "Bật Extreme Anti-Lag (Ban Ngày) + Auto Nộ + Anti-AFK"
ExtremeBtn.TextSize = 13
ExtremeBtn.Font = Enum.Font.SourceSansBold
ExtremeBtn.Parent = ContentContainer

local extremeActivated = false

ExtremeBtn.MouseButton1Click:Connect(function()
    if extremeActivated then return end
    extremeActivated = true
    ExtremeBtn.BackgroundColor3 = Color3.fromRGB(40, 180, 40)
    ExtremeBtn.Text = "Đã Bật Anti-Lag Ban Ngày & Auto Nộ"

    task.spawn(function()
        local VirtualUser = game:GetService("VirtualUser")
        
        LocalPlayer.Idled:Connect(function()
            VirtualUser:CaptureController()
            VirtualUser:ClickButton2(Vector2.new(0, 0))
        end)
        
        while true do
            pcall(function()
                VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.G, false, game)
                task.wait(0.05)
                VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.G, false, game)
                
                local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
                if playerGui then
                    local function clickGuiPath(path)
                        local elem = playerGui
                        for _, v in ipairs(path) do
                            if elem then elem = elem:FindFirstChild(v) end
                        end
                        if elem and elem.AbsolutePosition.X > 0 and elem.AbsoluteSize.X > 0 then
                            local x = elem.AbsolutePosition.X + (elem.AbsoluteSize.X / 2)
                            local y = elem.AbsolutePosition.Y + (elem.AbsoluteSize.Y / 2)
                            VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 1)
                            task.wait(0.02)
                            VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 1)
                        end
                    end
                    clickGuiPath({"MobileButtons", "Awakening"})
                    clickGuiPath({"TouchGui", "AwakeningButton"})
                end
            end)
            task.wait(10)
        end
    end)

    local SoundService = game:GetService("SoundService")
    local StarterGui = game:GetService("StarterGui")

    local function isPlayerCharacter(obj)
        for _, player in ipairs(Players:GetPlayers()) do
            if player.Character and obj:IsDescendantOf(player.Character) then
                return true
            end
        end
        return false
    end

    local function cleanObject(obj)
        if obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam") 
           or obj:IsA("Fire") or obj:IsA("Smoke") or obj:IsA("Explosion") 
           or obj:IsA("Sparkles") or obj:IsA("Highlight") or obj:IsA("Decal") 
           or obj:IsA("Texture") or obj:IsA("Clouds") or obj:IsA("Sky") 
           or obj:IsA("PostEffect") or obj:IsA("Atmosphere") or obj:IsA("Sound") then
            
            if not isPlayerCharacter(obj) then
                obj:Destroy()
            end
            
        elseif (obj:IsA("BasePart") or obj:IsA("MeshPart")) then
            if not isPlayerCharacter(obj) then
                obj.Transparency = 1
                obj.CastShadow = false
                obj.Material = Enum.Material.SmoothPlastic
            end
        end
    end

    local function nukeEverything()
        pcall(function() StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.All, false) end)
        
        Lighting.Brightness = 2
        Lighting.ClockTime = 14
        Lighting.Ambient = Color3.fromRGB(150, 150, 150)
        Lighting.OutdoorAmbient = Color3.fromRGB(150, 150, 150)
        Lighting.GlobalShadows = false
        
        for _, sound in ipairs(SoundService:GetDescendants()) do 
            if sound:IsA("Sound") and not isPlayerCharacter(sound) then 
                sound:Destroy() 
            end 
        end

        for _, obj in ipairs(workspace:GetDescendants()) do
            cleanObject(obj)
        end
    end

    nukeEverything()

    workspace.DescendantAdded:Connect(function(obj)
        task.delay(0.01, function()
            cleanObject(obj)
        end)
    end)
end)
