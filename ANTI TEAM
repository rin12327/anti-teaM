                    triggerMobileButton({"Hotbar", "Backpack"})
                    triggerMobileButton({"MobileButtons", "Combat", "Punch"})
                    triggerMobileButton({"TouchGui", "TouchControlFrame", "DynamicThumbstick"})
                end

                task.wait(0.15) -- Khoảng nghỉ nhỏ giữa 2 cú đấm

