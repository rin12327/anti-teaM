    if not hrp then return end

    local targetHRP = p.Character.HumanoidRootPart
    if lastAttackTarget ~= selectedAttackTarget then
        lastAttackTarget = selectedAttackTarget
        attackTracker.reset()
    end
    local vel = attackTracker.update(targetHRP)
    if vel.Magnitude > 200 then vel = Vector3.zero end

    local predicted = targetHRP.Position + vel * getLead()
    local look = targetHRP.CFrame.LookVector
    look = Vector3.new(look.X, 0, look.Z)
    if look.Magnitude < 0.01 then return end
    look = look.Unit

    hrp.CFrame = CFrame.lookAt(predicted - look * 5, Vector3.new(predicted.X, predicted.Y, predicted.Z))
    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero
end))

