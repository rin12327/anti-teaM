                        local targetElem = playerGui
                        for _, v in ipairs(pathName) do
                            if targetElem then targetElem = targetElem:FindFirstChild(v) end
                        end
                        if targetElem and targetElem.AbsolutePosition.X > 0 and targetElem.AbsoluteSize.X > 0 then
