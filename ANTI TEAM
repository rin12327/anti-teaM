RunService.Heartbeat:Connect(function()
    if not attackActive or not selectedAttackTarget then return end
    local p = Players:FindFirstChild(selectedAttackTarget)
    if not p or not p.Character or not p.Character:FindFirstChild("HumanoidRootPart") then return end
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    
    local hrp = char.HumanoidRootPart
    local targetHRP = p.Character.HumanoidRootPart
    local tVel = targetHRP.AssemblyLinearVelocity
    
    -- THUẬT TOÁN DỰ ĐOÁN ĐÓN ĐẦU: Mục tiêu di chuyển tới đâu, ta tự động nhích lên đón đầu hướng đó để bù độ trễ mạng
    local predictedTargetPos = targetHRP.Position + (tVel * 0.15)
    hrp.CFrame = CFrame.new(predictedTargetPos - (targetHRP.CFrame.LookVector * 5), targetHRP.Position)
    hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
    hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
end)

-- LUỒNG RIÊNG 1: ĐÁNH THƯỜNG LIÊN TỤC KHÔNG NGẮT NHỊP (2 cái trong 0.6 giây, lặp lại vô tận)
task.spawn(function()
    while true do
        if attackActive and selectedAttackTarget then
            pcall(function()
                for i = 1, 2 do
                    if not attackActive or not selectedAttackTarget then break end
                    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 1)
                    task.wait(0.02)
                    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 1)
                    task.wait(0.28)
                end
            end)
        else
            task.wait(0.1)
        end
        task.wait()
    end
end)

-- LUỒNG RIÊNG 2: TỰ ĐỘNG TUNG CHIÊU 1, 2, 3, 4 (Mỗi chiêu cách nhau đúng 1 giây)
task.spawn(function()
    local skills = {Enum.KeyCode.One, Enum.KeyCode.Two, Enum.KeyCode.Three, Enum.KeyCode.Four}
    while true do
        if attackActive and selectedAttackTarget then
            pcall(function()
                for _, key in ipairs(skills) do
                    if not attackActive or not selectedAttackTarget then break end
                    
                    local success = false
                    while not success and attackActive and selectedAttackTarget do
                        pcall(function()
                            VirtualInputManager:SendKeyEvent(true, key, false, game)
                            task.wait(0.03)
                            VirtualInputManager:SendKeyEvent(false, key, false, game)
                            
                            local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
                            if playerGui then
                                local hotbar = playerGui:FindFirstChild("Hotbar")
                                if hotbar then
                                    local backpackUI = hotbar:FindFirstChild("Backpack") or hotbar:FindFirstChild("MobileButtons") or hotbar:FindFirstChild("Skills")
                                    if backpackUI and backpackUI.AbsolutePosition.X > 0 then
                                        local sectionWidth = backpackUI.AbsoluteSize.X / 4
                                        local targetX = backpackUI.AbsolutePosition.X + (sectionWidth * (math.random(0, 3))) + (sectionWidth / 2)
                                        local targetY = backpackUI.AbsolutePosition.Y + (backpackUI.AbsoluteSize.Y / 2)
                                        VirtualInputManager:SendMouseButtonEvent(targetX, targetY, 0, true, game, 1)
                                        task.wait(0.01)
                                        VirtualInputManager:SendMouseButtonEvent(targetX, targetY, 0, false, game, 1)
                                    end
                                end
                            end
                            success = true
                        end)
                        if not success then
                            task.wait(0.05)
                        end
                    end
                    
                    task.wait(1.0)
                end
            end)
        else
            task.wait(0.2)
        end
    end
end)

