    local List = Instance.new("ScrollingFrame")
    List.Size = UDim2.new(1, 0, 0, 118)
    List.BackgroundColor3 = THEME.panel
    List.BorderSizePixel = 0
    List.CanvasSize = UDim2.new(0, 0, 0, 0)
    List.AutomaticCanvasSize = Enum.AutomaticSize.Y
    List.ScrollBarThickness = 4
    List.LayoutOrder = nextOrder()
    List.Parent = parent
    round(List, 8)

    local layout = Instance.new("UIListLayout")
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Padding = UDim.new(0, 4)
    layout.Parent = List
    local pad = Instance.new("UIPadding")
    pad.PaddingTop = UDim.new(0, 4)
    pad.PaddingLeft = UDim.new(0, 4)
    pad.PaddingRight = UDim.new(0, 8)
    pad.PaddingBottom = UDim.new(0, 4)
    pad.Parent = List

    local function refreshList()
        for _, child in ipairs(List:GetChildren()) do
            if child:IsA("TextButton") then child:Destroy() end
        end
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then
                local btn = Instance.new("TextButton")
                btn.Size = UDim2.new(1, 0, 0, 30)
                btn.BackgroundColor3 = THEME.item
                btn.TextColor3 = THEME.text
                btn.Text = "  " .. p.DisplayName .. "  (@" .. p.Name .. ")"
                btn.TextSize = 12
                btn.Font = Enum.Font.Gotham
                btn.TextXAlignment = Enum.TextXAlignment.Left
                btn.TextTruncate = Enum.TextTruncate.AtEnd
                btn.Parent = List
                round(btn, 6)

                if isMultiSelect and table.find(selectedFlingPlayers, p.Name) then
                    btn.BackgroundColor3 = THEME.danger
                elseif not isMultiSelect and selectedAttackTarget == p.Name then
                    btn.BackgroundColor3 = THEME.accent
                end
                btn.MouseButton1Click:Connect(function()
                    callback(p.Name)
                    refreshList()
                end)
            end
        end
    end
    track(Players.PlayerAdded:Connect(refreshList))
    track(Players.PlayerRemoving:Connect(function() task.defer(refreshList) end))
    refreshList()
end

