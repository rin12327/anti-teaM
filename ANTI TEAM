-- 3. ANTI-VOID (sàn an toàn + tự dịch chuyển về khi rơi)
---------------------------------------------------------
local antiVoidOn = false
local purged = false
local lastGround = nil

local function computeFloor()
    local c, hrp, hum = getChar()
    if not hrp then return nil end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {c}
    local res = workspace:Raycast(hrp.Position, Vector3.new(0, -80, 0), params)
    if res then return res.Position end
    local h = (hum and hum.HipHeight or 2) + hrp.Size.Y / 2
    return hrp.Position - Vector3.new(0, h, 0)
end

local function ensurePlatform()
    if platform and platform.Parent then return end
    local floor = computeFloor()
    if not floor then return end
    safeCenter = floor
    platform = Instance.new("Part")
    platform.Name = "TSB_SafePlatform"
    platform.Anchored = true
    platform.CanCollide = true
    platform.CanTouch = false
    platform.CastShadow = false
    platform.Size = Vector3.new(4000, 2, 4000)
    platform.CFrame = CFrame.new(floor.X, floor.Y - 1, floor.Z) -- mặt trên ngang mặt đất
    platform.Material = Enum.Material.SmoothPlastic
    platform.Color = Color3.fromRGB(90, 90, 90)
    platform.Transparency = purged and 0 or 1
    platform.Parent = workspace
end

local AntiVoidBtn = makeButton("Bật/Tắt Anti-Void (sàn an toàn, không chết vì rơi)", Color3.fromRGB(150, 110, 0), 32)

local function setAntiVoid(on)
    antiVoidOn = on
    AntiVoidBtn.BackgroundColor3 = on and GREEN or Color3.fromRGB(150, 110, 0)
    if on then ensurePlatform() end
end
AntiVoidBtn.MouseButton1Click:Connect(function() setAntiVoid(not antiVoidOn) end)

local lastGroundT = 0
track(RunService.Heartbeat:Connect(function()
    if not antiVoidOn or not safeCenter then return end
    if not (platform and platform.Parent) then ensurePlatform() end
    local _, hrp, hum = getChar()
    if not hrp or not hum then return end
    local pos = hrp.Position
    local lowLimit = safeCenter.Y - 40

    if tick() - lastGroundT > 0.25 and hum.FloorMaterial ~= Enum.Material.Air and pos.Y > lowLimit + 20 then
        lastGround = pos
        lastGroundT = tick()
    end

    local flat = Vector2.new(pos.X - safeCenter.X, pos.Z - safeCenter.Z)
    if pos.Y < lowLimit or flat.Magnitude > 1900 or pos.Y ~= pos.Y then
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        local back = lastGround or (safeCenter + Vector3.new(0, 4, 0))
        hrp.CFrame = CFrame.new(back + Vector3.new(0, 4, 0))
    end
end))

