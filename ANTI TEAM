-- 3. EXTREME ANTI-LAG (BAN NGÀY), ANTI-AFK ENGINE & SAFETY FLOOR (Y=100)
---------------------------------------------------------
local ExtremeBtn = Instance.new("TextButton")
ExtremeBtn.Size = UDim2.new(1, 0, 0, 35)
ExtremeBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 120)
ExtremeBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
ExtremeBtn.Text = "Bật Extreme Anti-Lag (Ban Ngày) + Sàn Y100 + Anti-AFK"
ExtremeBtn.TextSize = 13
ExtremeBtn.Font = Enum.Font.SourceSansBold
ExtremeBtn.Parent = ContentContainer

local extremeActivated = false

ExtremeBtn.MouseButton1Click:Connect(function()
    if extremeActivated then return end
    extremeActivated = true
    ExtremeBtn.BackgroundColor3 = Color3.fromRGB(40, 180, 40)
    ExtremeBtn.Text = "Đã Bật Anti-Lag Ban Ngày & Sàn Y100"

    -- =======================================================
    -- 1. AUTOMATIC ANTI-AFK ENGINE
    -- =======================================================
    task.spawn(function()
        local VirtualUser = game:GetService("VirtualUser")
        
        LocalPlayer.Idled:Connect(function()
            VirtualUser:CaptureController()
            VirtualUser:ClickButton2(Vector2.new(0, 0))
        end)
        
        while task.wait(300) do
            pcall(function()
                VirtualUser:CaptureController()
                VirtualUser:Button2Down(Vector2.new(0, 0), workspace.CurrentCamera.CFrame)
                task.wait(0.1)
                VirtualUser:Button2Up(Vector2.new(0, 0), workspace.CurrentCamera.CFrame)
            end)
        end
    end)

    -- =========================================================
    -- 2. CREATE SAFETY FLOOR (CỐ ĐỊNH Y = 100, DI CHUYỂN X, Z)
    -- =========================================================
    local floorName = "TSB_SafetyFloor_Y100"
    local oldFloor = workspace:FindFirstChild(floorName)
    if oldFloor then oldFloor:Destroy() end

    local safetyFloor = Instance.new("Part")
    safetyFloor.Name = floorName
    safetyFloor.Size = Vector3.new(100, 5, 100)
    safetyFloor.Anchored = true
    safetyFloor.CanCollide = true
    safetyFloor.Transparency = 0.5 
    safetyFloor.Material = Enum.Material.SmoothPlastic
    safetyFloor.Color = Color3.fromRGB(0, 255, 150)
    safetyFloor.Parent = workspace

    RunService.Heartbeat:Connect(function()
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            local hrpPos = char.HumanoidRootPart.Position
            safetyFloor.CFrame = CFrame.new(hrpPos.X, 100, hrpPos.Z)
        end
    end)

    -- =========================================================
    -- 3. EXTREME ANTI-LAG (BAN NGÀY & HIỆN NGƯỜI CHƠI)
    -- =========================================================
    local SoundService = game:GetService("SoundService")
    local StarterGui = game:GetService("StarterGui")

    local function isPlayerCharacter(obj)
        for _, player in ipairs(Players:GetPlayers()) do
            if player.Character and obj:IsDescendantOf(player.Character) then
                return true
            end
        end
        return false
    end

    local function cleanObject(obj)
        if obj == safetyFloor then return end

        if obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam") 
           or obj:IsA("Fire") or obj:IsA("Smoke") or obj:IsA("Explosion") 
           or obj:IsA("Sparkles") or obj:IsA("Highlight") or obj:IsA("Decal") 
           or obj:IsA("Texture") or obj:IsA("Clouds") or obj:IsA("Sky") 
           or obj:IsA("PostEffect") or obj:IsA("Atmosphere") or obj:IsA("Sound") then
            
            if not isPlayerCharacter(obj) then
                obj:Destroy()
            end
            
        elseif (obj:IsA("BasePart") or obj:IsA("MeshPart")) then
            if not isPlayerCharacter(obj) then
                obj.Transparency = 1
                obj.CastShadow = false
                obj.Material = Enum.Material.SmoothPlastic
            end
        end
    end

    local function nukeEverything()
        pcall(function() StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.All, false) end)
        
        -- ÁNH SÁNG BAN NGÀY
        Lighting.Brightness = 2
        Lighting.ClockTime = 14
        Lighting.Ambient = Color3.fromRGB(150, 150, 150)
        Lighting.OutdoorAmbient = Color3.fromRGB(150, 150, 150)
        Lighting.GlobalShadows = false
        
        for _, obj in ipairs(Lighting:GetChildren()) do 
            if not obj:IsA("Atmosphere") and not obj:IsA("Sky") then end 
        end
        
        for _, sound in ipairs(SoundService:GetDescendants()) do 
            if sound:IsA("Sound") and not isPlayerCharacter(sound) then 
                sound:Destroy() 
            end 
        end

        for _, obj in ipairs(workspace:GetDescendants()) do
            cleanObject(obj)
        end
    end

    nukeEverything()

    workspace.DescendantAdded:Connect(function(obj)
        task.delay(0.01, function()
            cleanObject(obj)
        end)
    end)
end)
