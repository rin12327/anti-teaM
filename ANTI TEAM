        if delta.Magnitude > 5 then
            hasMoved = true
        end
        BubbleBtn.Position = UDim2.new(bubbleStartPos.X.Scale, bubbleStartPos.X.Offset + delta.X, bubbleStartPos.Y.Scale, bubbleStartPos.Y.Offset + delta.Y)
