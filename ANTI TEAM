local function newTracker()
    local t = {pos = nil, time = 0, vel = Vector3.zero}
    function t.update(part)
        local now = tick()
        if not t.pos then
            t.pos = part.Position
            t.time = now
            return t.vel
        end
        local dt = now - t.time
        if dt >= 1 / 120 then
            local raw = (part.Position - t.pos) / dt
            t.vel = t.vel:Lerp(raw, 0.5)
            t.pos = part.Position
            t.time = now
        end
        return t.vel
    end
    function t.reset()
        t.pos = nil
        t.vel = Vector3.zero
    end
    return t
end

local function getLead()
    local ok, ping = pcall(function() return LocalPlayer:GetNetworkPing() end)
    ping = ok and ping or 0.1
    return math.clamp(ping + 0.05, 0.06, 0.3)
end

-- CFrame đứng ở `from` và quay mặt (nằm ngang) về phía `to`
local function faceCF(from, to, fallbackDir)
    local d = Vector3.new(to.X - from.X, 0, to.Z - from.Z)
    if d.Magnitude < 0.05 then
        d = Vector3.new(fallbackDir.X, 0, fallbackDir.Z)
        if d.Magnitude < 0.05 then d = Vector3.new(0, 0, -1) end
    end
    return CFrame.lookAt(from, from + d.Unit)
end

local function zeroSelf(hrp)
    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero
end

