local inputBusy = false

local function tapScreen(x, y, holdTime, touchId)
    while inputBusy do task.wait() end
    inputBusy = true
    holdTime = holdTime or 0.03
    touchId = touchId or 7
    pcall(function()
        if isMobile then
            pcall(function() VirtualInputManager:SendTouchEvent(touchId, 0, x, y) end)
        end
        VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 1)
        task.wait(holdTime)
        if isMobile then
            pcall(function() VirtualInputManager:SendTouchEvent(touchId, 2, x, y) end)
        end
        VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 1)
    end)
    inputBusy = false
end

local function guiInset(elem)
    local sg = elem:FindFirstAncestorOfClass("ScreenGui")
    if sg and sg.IgnoreGuiInset then return Vector2.new(0, 0) end
    return GuiService:GetGuiInset()
end

local function guiCenter(elem)
    local inset = guiInset(elem)
    return elem.AbsolutePosition.X + elem.AbsoluteSize.X / 2 + inset.X,
           elem.AbsolutePosition.Y + elem.AbsoluteSize.Y / 2 + inset.Y
end

-- Dò nút đánh thường trên giao diện điện thoại
local function matchAttackName(n)
    if n == "m1" or n:find("^m1") then return true end
    for _, key in ipairs({"attack", "punch", "combat", "fist"}) do
        if n:find(key, 1, true) then return true end
    end
    return false
end

local function findAttackButton()
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if not pg then return nil end
    for _, d in ipairs(pg:GetDescendants()) do
        if (d:IsA("ImageButton") or d:IsA("TextButton")) and d.Visible and d.AbsoluteSize.X > 10 then
            local n = d.Name:lower()
            local t = d:IsA("TextButton") and d.Text:lower() or ""
            if matchAttackName(n) or t == "m1" or t == "attack" or t == "punch" then
                return d
            end
        end
    end
    return nil
end

local calibratedPos = nil
local cachedAttackBtn = nil

local function doM1()
    -- 1) Vị trí người dùng tự hiệu chỉnh (chắc chắn nhất trên điện thoại)
    if calibratedPos then
        tapScreen(calibratedPos.X, calibratedPos.Y, 0.03, 7)
        return
    end
    -- 2) Tự dò nút đánh trên điện thoại
    if isMobile then
        if not (cachedAttackBtn and cachedAttackBtn.Parent) then
            cachedAttackBtn = findAttackButton()
        end
        if cachedAttackBtn then
            if firesignal then
                pcall(firesignal, cachedAttackBtn.MouseButton1Down)
                pcall(firesignal, cachedAttackBtn.Activated)
            end
            local x, y = guiCenter(cachedAttackBtn)
            tapScreen(x, y, 0.03, 7)
            return
        end
    end
    -- 3) PC: click chuột trái như cũ
    tapScreen(0, 0, 0.02, 7)
end

